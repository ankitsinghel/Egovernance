generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Use DATABASE_URL environment variable. Set this in GitHub Secrets and in
  // Vercel (Production). Example: postgresql://user:password@host:5432/dbname
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  admins  Admin[]
  reports UserReport[]
}

model State {
  id      Int          @id @default(autoincrement())
  name    String       @unique
  admins  Admin[]
  reports UserReport[]
}

model Admin {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  password        String
  departmentId    Int
  department      Department   @relation(fields: [departmentId], references: [id])
  stateId         Int?
  state           State?       @relation(fields: [stateId], references: [id])
  // role stored as a number (was previously a string)
  role            Int
  superiorId      Int?
  superior        Admin?       @relation("Superior", fields: [superiorId], references: [id])
  subordinates    Admin[]      @relation("Superior")
  assignedReports UserReport[] @relation("AssignedReports")
  actions         ActionLog[]
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String
  RolePermission RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  roles       RolePermission[]
}

// Join table for many-to-many between Role and Permission
model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserReport {
  id           Int           @id @default(autoincrement())
  trackingId   String        @unique
  departmentId Int
  department   Department    @relation(fields: [departmentId], references: [id])
  designation  String?
  accusedName  String?
  stateId      Int?
  state        State?        @relation(fields: [stateId], references: [id])
  description  String
  files        Reportfiles[]
  // store status as numeric id referring to lib/statuses.ts
  status       Int           @default(1)
  assignedToId Int?
  assignedTo   Admin?        @relation("AssignedReports", fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  actions      ActionLog[]
}

model Reportfiles {
  id       Int        @id @default(autoincrement())
  reportId String
  report   UserReport @relation(fields: [reportId], references: [trackingId], onDelete: Cascade)
  filePath String
}

model ActionLog {
  id           Int        @id @default(autoincrement())
  report       UserReport @relation(fields: [reportId], references: [id])
  reportId     Int
  admin        Admin?     @relation(fields: [adminId], references: [id])
  adminId      Int?
  statusChange Int
  note         String?
  proofFile    String?
  createdAt    DateTime   @default(now())
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  tokenHash String
  purpose   String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  meta      String?
}

model SuperAdmin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
